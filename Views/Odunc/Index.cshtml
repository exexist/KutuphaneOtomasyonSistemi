@model List<Odunc>
@{
    ViewData["Title"] = "Ödünç İşlemleri";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-title">
        <div class="page-header-icon"><i class="bi bi-arrow-left-right"></i></div>
        <div>
            <h3 class="mb-0">Ödünç İşlemleri</h3>
            <p class="page-header-subtitle">Toplam @Model.Count kayıt</p>
        </div>
    </div>
    <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>Yeni Ödünç Kaydı</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>Henüz bir ödünç kaydı bulunmuyor.</p>
        <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>İlk Kaydı Oluştur</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped bg-white shadow-sm mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Kitap</th>
                    <th>Üye</th>
                    <th>Alış Tarihi</th>
                    <th>Teslim Tarihi</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var gecikmis = !o.IadeEdildiMi && o.TeslimTarihi < DateTime.Now;
                    <tr class="@(gecikmis ? "table-danger" : "")">
                        <td><i class="bi bi-book me-2 text-primary"></i>@(o.Kitap?.Ad ?? "-")</td>
                        <td>@(o.Uye?.AdSoyad ?? "-")</td>
                        <td>@o.AlisTarihi.ToString("dd.MM.yyyy")</td>
                        <td>@o.TeslimTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (o.IadeEdildiMi)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>İade Edildi</span>
                            }
                            else if (gecikmis)
                            {
                                <span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>Gecikti</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Devam Ediyor</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!o.IadeEdildiMi)
                            {
                                <form asp-action="IadeAl" asp-route-id="@o.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-check2-circle"></i> İade Al</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-danger" asp-action="Sil" asp-route-id="@o.Id"><i class="bi bi-trash3"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
