@model Odunc
@{
    ViewData["Title"] = "Yeni Ödünç Kaydı";
    Layout = "_AdminLayout";
}

<h3><i class="bi bi-plus-circle me-2"></i>Yeni Ödünç Kaydı</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Ekle" method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="KitapId" class="form-label"></label>
        <select asp-for="KitapId" asp-items="ViewBag.KitapId" class="form-select">
            <option value="">-- Kitap Seçiniz --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="UyeId" class="form-label"></label>
        <select asp-for="UyeId" asp-items="ViewBag.UyeId" class="form-select">
            <option value="">-- Üye Seçiniz --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="AlisTarihi" class="form-label"></label>
        <input asp-for="AlisTarihi" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="TeslimTarihi" class="form-label"></label>
        <input asp-for="TeslimTarihi" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
