@model List<Kitap>
@{
    ViewData["Title"] = "Anasayfa";
}

<div class="hero mb-4">
    <h1 class="display-6"><i class="bi bi-stars me-2"></i>Kütüphane Otomasyon Sistemine Hoş Geldiniz</h1>
    <p class="lead">Geniş kitap koleksiyonumuzu keşfedin, ücretsiz üye olun ve ödünç işlemlerinizi kolayca takip edin.</p>
    @if (User?.Identity == null || !User.Identity.IsAuthenticated)
    {
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <a class="btn btn-nav-primary" asp-controller="UyeHesap" asp-action="Kayit"><i class="bi bi-person-plus me-1"></i>Hemen Üye Ol</a>
            <a class="btn btn-nav-outline" asp-controller="UyeHesap" asp-action="Giris"><i class="bi bi-box-arrow-in-right me-1"></i>Üye Girişi</a>
        </div>
    }
</div>

<div class="row mb-4 g-3">
    <div class="col-md-4">
        <div class="card stat-card accent-primary text-center p-4">
            <div class="stat-icon mx-auto"><i class="bi bi-journal-bookmark"></i></div>
            <h3 class="text-primary">@ViewBag.ToplamKitap</h3>
            <p class="text-muted mb-0">Toplam Kitap Türü</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card accent-secondary text-center p-4">
            <div class="stat-icon mx-auto"><i class="bi bi-tags"></i></div>
            <h3 class="text-secondary">@ViewBag.ToplamKategori</h3>
            <p class="text-muted mb-0">Kategori</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card accent-info text-center p-4">
            <div class="stat-icon mx-auto"><i class="bi bi-people"></i></div>
            <h3 class="text-info">@ViewBag.ToplamUye</h3>
            <p class="text-muted mb-0">Kayıtlı Üye</p>
        </div>
    </div>
</div>

<div class="section-heading">
    <i class="bi bi-award section-heading-icon fs-4"></i>
    <h3 class="mb-0">Neden Bizi Tercih Etmelisiniz</h3>
</div>
<div class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="card feature-tile">
            <div class="feature-icon"><i class="bi bi-lightning-charge"></i></div>
            <h5>Hızlı ve Kolay</h5>
            <p>Birkaç tıklamayla üye olun, kitapları inceleyin ve ödünç işlemlerinizi takip edin.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-tile">
            <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
            <h5>Güvenli Altyapı</h5>
            <p>Şifreleriniz güvenli şekilde saklanır, kişisel verileriniz korunur.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-tile">
            <div class="feature-icon"><i class="bi bi-graph-up"></i></div>
            <h5>Güncel Katalog</h5>
            <p>Sürekli güncellenen geniş kitap koleksiyonuyla aradığınızı kolayca bulun.</p>
        </div>
    </div>
</div>

<div class="section-heading">
    <i class="bi bi-collection section-heading-icon fs-4"></i>
    <h3 class="mb-0">Kitap Kataloğu</h3>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover bg-white shadow-sm mb-0">
        <thead class="table-dark">
            <tr>
                <th>Kitap Adı</th>
                <th>Yazar</th>
                <th>Kategori</th>
                <th>Yayın Yılı</th>
                <th>Müsait Adet</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kitap in Model)
            {
                <tr>
                    <td><i class="bi bi-book me-2 text-primary"></i>@kitap.Ad</td>
                    <td>@kitap.Yazar</td>
                    <td><span class="badge bg-secondary">@(kitap.Kategori?.Ad ?? "-")</span></td>
                    <td>@kitap.YayinYili</td>
                    <td>
                        @if (kitap.MusaitAdet > 0)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>@kitap.MusaitAdet adet</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Müsait değil</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
