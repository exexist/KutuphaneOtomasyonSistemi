@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kütüphane Otomasyon Sistemi</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-brand-panel">
            <a class="auth-brand-logo" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half"></i> Kütüphane Otomasyon
            </a>
            <div class="auth-brand-content">
                @RenderSection("BrandPanel", required: false)
            </div>
            <div class="auth-brand-shape auth-brand-shape-1"></div>
            <div class="auth-brand-shape auth-brand-shape-2"></div>
        </div>
        <div class="auth-form-panel">
            <div class="auth-form-inner">
                @if (TempData["Basari"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm anim-fade-in" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Basari"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Hata"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm anim-fade-in" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Hata"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
