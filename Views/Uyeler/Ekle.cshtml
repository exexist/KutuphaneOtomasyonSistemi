@model Uye
@{
    ViewData["Title"] = "Yeni Üye";
    Layout = "_AdminLayout";
}

<h3><i class="bi bi-plus-circle me-2"></i>Yeni Üye Ekle</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Ekle" method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="AdSoyad" class="form-label"></label>
        <input asp-for="AdSoyad" class="form-control" />
        <span asp-validation-for="AdSoyad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Eposta" class="form-label"></label>
        <input asp-for="Eposta" class="form-control" />
        <span asp-validation-for="Eposta" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefon" class="form-label"></label>
        <input asp-for="Telefon" class="form-control" />
        <span asp-validation-for="Telefon" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label for="sifre" class="form-label">Şifre</label>
        <input type="password" id="sifre" name="sifre" class="form-control" minlength="6" required />
        <div class="form-text">Üye bu şifre ile siteye kendi giriş yapabilir. En az 6 karakter.</div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
