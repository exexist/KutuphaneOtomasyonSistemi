@model List<Uye>
@{
    ViewData["Title"] = "Üyeler";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-title">
        <div class="page-header-icon"><i class="bi bi-people"></i></div>
        <div>
            <h3 class="mb-0">Üyeler</h3>
            <p class="page-header-subtitle">Toplam @Model.Count kayıt</p>
        </div>
    </div>
    <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>Yeni Üye</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <div class="input-group">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Ad soyad veya e-posta ile ara..." />
    </div>
    <button type="submit" class="btn btn-outline-primary">Ara</button>
</form>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>Henüz kayıtlı bir üye bulunmuyor.</p>
        <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>İlk Üyeyi Ekle</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped bg-white shadow-sm mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th>Kayıt Tarihi</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var uye in Model)
                {
                    <tr>
                        <td><i class="bi bi-person-circle me-2 text-primary"></i>@uye.AdSoyad</td>
                        <td>@uye.Eposta</td>
                        <td>@(uye.Telefon ?? "-")</td>
                        <td>@uye.KayitTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Duzenle" asp-route-id="@uye.Id"><i class="bi bi-pencil-square"></i> Düzenle</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Sil" asp-route-id="@uye.Id"><i class="bi bi-trash3"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
