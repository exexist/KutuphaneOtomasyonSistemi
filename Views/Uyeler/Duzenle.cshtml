@model Uye
@{
    ViewData["Title"] = "Üye Düzenle";
    Layout = "_AdminLayout";
}

<h3><i class="bi bi-pencil-square me-2"></i>Üye Düzenle</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Duzenle" asp-route-id="@Model.Id" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="AdSoyad" class="form-label"></label>
        <input asp-for="AdSoyad" class="form-control" />
        <span asp-validation-for="AdSoyad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Eposta" class="form-label"></label>
        <input asp-for="Eposta" class="form-control" />
        <span asp-validation-for="Eposta" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefon" class="form-label"></label>
        <input asp-for="Telefon" class="form-control" />
        <span asp-validation-for="Telefon" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label for="yeniSifre" class="form-label">Yeni Şifre</label>
        <input type="password" id="yeniSifre" name="yeniSifre" class="form-control" minlength="6" />
        <div class="form-text">Şifreyi değiştirmek istemiyorsanız boş bırakın.</div>
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
