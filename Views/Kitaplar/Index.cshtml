@model List<Kitap>
@{
    ViewData["Title"] = "Kitaplar";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-title">
        <div class="page-header-icon"><i class="bi bi-book"></i></div>
        <div>
            <h3 class="mb-0">Kitaplar</h3>
            <p class="page-header-subtitle">Toplam @Model.Count kayıt</p>
        </div>
    </div>
    <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>Yeni Kitap</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <div class="input-group">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Kitap adı veya yazar ile ara..." />
    </div>
    <button type="submit" class="btn btn-outline-primary">Ara</button>
</form>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>Henüz kayıtlı bir kitap bulunmuyor.</p>
        <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>İlk Kitabı Ekle</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped bg-white shadow-sm mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Kitap Adı</th>
                    <th>Yazar</th>
                    <th>Kategori</th>
                    <th>Yayın Yılı</th>
                    <th>Stok</th>
                    <th>Müsait</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kitap in Model)
                {
                    <tr>
                        <td><i class="bi bi-book me-2 text-primary"></i>@kitap.Ad</td>
                        <td>@kitap.Yazar</td>
                        <td><span class="badge bg-secondary">@(kitap.Kategori?.Ad ?? "-")</span></td>
                        <td>@kitap.YayinYili</td>
                        <td>@kitap.StokAdedi</td>
                        <td>
                            @if (kitap.MusaitAdet > 0)
                            {
                                <span class="badge bg-success">@kitap.MusaitAdet</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">0</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Duzenle" asp-route-id="@kitap.Id"><i class="bi bi-pencil-square"></i> Düzenle</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Sil" asp-route-id="@kitap.Id"><i class="bi bi-trash3"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
