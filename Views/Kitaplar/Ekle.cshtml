@model Kitap
@{
    ViewData["Title"] = "Yeni Kitap";
    Layout = "_AdminLayout";
}

<h3><i class="bi bi-plus-circle me-2"></i>Yeni Kitap Ekle</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Ekle" method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="Ad" class="form-label"></label>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Yazar" class="form-label"></label>
        <input asp-for="Yazar" class="form-control" />
        <span asp-validation-for="Yazar" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Isbn" class="form-label"></label>
        <input asp-for="Isbn" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="YayinYili" class="form-label"></label>
        <input asp-for="YayinYili" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="KategoriId" class="form-label"></label>
        <select asp-for="KategoriId" asp-items="ViewBag.KategoriId" class="form-select">
            <option value="">-- Kategori Seçiniz --</option>
        </select>
        <span asp-validation-for="KategoriId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StokAdedi" class="form-label"></label>
        <input asp-for="StokAdedi" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
