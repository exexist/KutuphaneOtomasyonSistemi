@model List<Kategori>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-title">
        <div class="page-header-icon"><i class="bi bi-tags"></i></div>
        <div>
            <h3 class="mb-0">Kategoriler</h3>
            <p class="page-header-subtitle">Toplam @Model.Count kayıt</p>
        </div>
    </div>
    <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>Yeni Kategori</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>Henüz kayıtlı bir kategori bulunmuyor.</p>
        <a class="btn btn-primary" asp-action="Ekle"><i class="bi bi-plus-lg me-1"></i>İlk Kategoriyi Ekle</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped bg-white shadow-sm mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Kategori Adı</th>
                    <th>Kitap Sayısı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td><i class="bi bi-tag me-2 text-primary"></i>@k.Ad</td>
                        <td><span class="badge bg-secondary">@(k.Kitaplar?.Count ?? 0)</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Duzenle" asp-route-id="@k.Id"><i class="bi bi-pencil-square"></i> Düzenle</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Sil" asp-route-id="@k.Id"><i class="bi bi-trash3"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
