@model Kategori
@{
    ViewData["Title"] = "Yeni Kategori";
    Layout = "_AdminLayout";
}

<h3><i class="bi bi-plus-circle me-2"></i>Yeni Kategori Ekle</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Ekle" method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="Ad" class="form-label"></label>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
