@model Kategori
@{
    ViewData["Title"] = "Kategori Düzenle";
    Layout = "_AdminLayout";
}

<h3><i class="bi bi-pencil-square me-2"></i>Kategori Düzenle</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Duzenle" asp-route-id="@Model.Id" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Ad" class="form-label"></label>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
